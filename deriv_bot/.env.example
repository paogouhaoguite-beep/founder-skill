# Copy to .env (never commit it) or export in your shell. Not needed for --paper.
# New Deriv API: a Personal Access Token with the "trade" scope (see
# https://developers.deriv.com/docs/intro/authentication/), plus api.app_id in config.yaml.
# Legacy API (api.protocol: legacy): a token from https://app.deriv.com/account/api-token
# created on your DEMO account with the Read + Trade scopes.
DERIV_API_TOKEN=your_demo_token_here
