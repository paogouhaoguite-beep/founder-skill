# A paid RPC is strongly recommended (Helius, QuickNode, Triton). The free
# public endpoint rate-limits hard and adds seconds of lag to every signal.
RPC_URL=https://api.mainnet-beta.solana.com
# WS_URL=wss://your-rpc-provider/ws

# Only needed for live mode. Use a fresh wallet that holds only what you are
# willing to lose. Base58 string or the [1,2,3,...] array from solana-keygen.
PRIVATE_KEY=

# Optional: Jupiter API key (use with JUPITER_BASE_URL=https://api.jup.ag/swap/v1)
# JUPITER_API_KEY=
# JUPITER_BASE_URL=https://api.jup.ag/swap/v1

# Overrides "mode" in config.json: paper | live
# MODE=paper
